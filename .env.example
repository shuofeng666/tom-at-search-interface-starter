GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

EXA_API_KEY=

# Comma-separated domain lists that app/api/search's fetchPrioritizedPool
# actually reads. (EXA_INCLUDE_DOMAINS below is legacy/unused dead code from
# an earlier version - fetchPoolPerDomain, the only function that reads it,
# is never called. Don't bother setting it.)
#
# - EXA_PRIMARY_DOMAINS: usually just tomglobal.org. This is now the
#   PREFERRED source for TOM results (app/api/search/route.ts puts these
#   ahead of the CSV catalog below, which only backfills if this doesn't
#   turn up enough). Results are filtered down to real /project?id=... URLs.
# - EXA_SECONDARY_DOMAINS: open-source/DIY assistive tech sites.
# - EXA_COMMERCIAL_DOMAINS: retail/commercial AT sites.
#
# Adding a domain here alone isn't enough for it to render with the right
# label (DIY project / open-source project / commercial product) - also add
# it to detectSourceType in lib/exa.ts, or it renders as "unknown".
EXA_PRIMARY_DOMAINS=tomglobal.org
EXA_SECONDARY_DOMAINS=instructables.com,thingiverse.com,printables.com,github.com,atmakers.org,makersmakingchange.com
EXA_COMMERCIAL_DOMAINS=amazon.com,walmart.com,etsy.com,enablingdevices.com
EXA_INCLUDE_DOMAINS=

# data/tom-solutions.csv is the TOM search fallback (used when live search
# above doesn't find enough) — no API key or URL needed for it. See "TOM
# project search" in README.md.
#
# TOM's live project API, used ONLY to fetch real project photos (the CSV
# export has none). Search/ranking never touches this endpoint — if it's
# unset or unreachable, TOM cards just show no photo, which is exactly the
# bug this was set to fix: this variable was missing from the production
# Vercel deployment for a long stretch, so TOM images silently never
# showed up no matter what the image-lookup code did. It's technically
# optional (the app still runs without it) but treat it as required for a
# correct-looking deployment. This is TOM's own public project-search API
# (reverse-engineered from tomglobal.org's own frontend bundle, not secret):
TOM_SEARCH_API_URL=https://api.tomglobal.org/api/v1/project/search
