GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

EXA_API_KEY=

# Comma-separated domain lists that app/api/search's fetchPrioritizedPool
# actually reads. (EXA_INCLUDE_DOMAINS below is legacy/unused dead code from
# an earlier version - fetchPoolPerDomain, the only function that reads it,
# is never called. Don't bother setting it.)
#
# - EXA_PRIMARY_DOMAINS: usually just tomglobal.org, as a semantic-search
#   supplement to the CSV-based TOM search below. Results are filtered down
#   to real /project?id=... URLs.
# - EXA_SECONDARY_DOMAINS: maker/DIY sites, e.g.
#   instructables.com,thingiverse.com,printables.com,github.com
# - EXA_COMMERCIAL_DOMAINS: retail sites, e.g. amazon.com,walmart.com,etsy.com
EXA_PRIMARY_DOMAINS=tomglobal.org
EXA_SECONDARY_DOMAINS=instructables.com,thingiverse.com,printables.com,github.com
EXA_COMMERCIAL_DOMAINS=amazon.com,walmart.com,etsy.com
EXA_INCLUDE_DOMAINS=

# TOM project search/ranking reads data/tom-solutions.csv directly — no API
# key or URL needed for that. See "TOM project catalog" in README.md.
#
# Optional: TOM's live project API, used ONLY to fetch real project photos
# (the CSV export has none). Search/ranking never touches this endpoint —
# if it's unset or unreachable, TOM cards just show no photo.
TOM_SEARCH_API_URL=

# Optional: mailto address for the "Request TOM team help" button shown on
# candidates that likely need TOM staff review.
NEXT_PUBLIC_TOM_CONTACT_EMAIL=
