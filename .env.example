GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

EXA_API_KEY=
EXA_INCLUDE_DOMAINS=https://https://tomglobal.org/results?search=&types=5,instructables.com,thingiverse.com,printables.com,github.com,amazon.com,walmart.com,etsy.com

# TOM project search/ranking reads data/tom-solutions.csv directly — no API
# key or URL needed for that. See "TOM project catalog" in README.md.
#
# Optional: TOM's live project API, used ONLY to fetch real project photos
# (the CSV export has none). Search/ranking never touches this endpoint —
# if it's unset or unreachable, TOM cards just show no photo.
TOM_SEARCH_API_URL=

# Optional: mailto address for the "Request TOM team help" button shown on
# candidates that likely need TOM staff review.
NEXT_PUBLIC_TOM_CONTACT_EMAIL=
